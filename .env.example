# Supabase project settings (Project Settings > API in the Supabase dashboard)
# Safe to expose to the browser — protected by Row Level Security, not secrecy.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Service role key — server-side only, NEVER expose to the browser or commit it.
# Not used by the frontend; only needed later for admin scripts/migrations run locally.
SUPABASE_SERVICE_ROLE_KEY=
